---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { sections } from '@/config/navigation';
---

<BaseLayout
  title="Offline"
  description="This lesson is not available offline yet."
  currentPath="/offline"
  showSidebar={false}
>
  <div class="lesson-content offline-page">
    <h1>Not available offline yet</h1>
    <p>
      This lesson is not saved on your device. You need an internet connection to open it until you
      download a track below.
    </p>
    <p>
      To read lessons without a connection, download a full track from Reading preferences (Aa in the
      header) → <strong>Offline lessons</strong>.
    </p>
    <p>While online, choose <strong>Download</strong> for Java, FTC, FRC, or Competitive. Then use the
      lesson sidebar or prev/next — you do not need search.</p>
    <h2>Learning tracks</h2>
    <ul>
      {sections.map((section) => (
        <li>
          <a href={section.path}>{section.label}</a>
        </li>
      ))}
    </ul>
    <p class="offline-page-note">
      In-browser Java Run still needs a network connection.
    </p>
  </div>
</BaseLayout>
