---
/**
 * The "Aa" button in the header. The drawer it opens is PreferencesDrawer.astro,
 * rendered by BaseLayout outside the header — the header is position: fixed with
 * a transform (and backdrop-filter in dark mode), so anything positioned inside
 * it is clipped to the header's height.
 */
---

<button
  class="prefs-toggle"
  type="button"
  data-prefs-toggle
  aria-haspopup="dialog"
  aria-expanded="false"
  aria-controls="prefs-drawer"
  aria-label="Reading preferences"
  title="Reading preferences"
>
  <span class="prefs-toggle-glyph" aria-hidden="true">Aa</span>
</button>

<script>
  import { hasActiveTeamColors, loadPrefs, type Prefs } from '@/lib/prefs';

  function reflectToggleTeam(prefs: Prefs) {
    document.querySelectorAll<HTMLButtonElement>('[data-prefs-toggle]').forEach((btn) => {
      const active = hasActiveTeamColors(prefs) && prefs.teamNumber != null;
      if (active && prefs.teamNumber != null) {
        btn.setAttribute('aria-label', `Reading preferences, team ${prefs.teamNumber} colors active`);
        btn.setAttribute('title', `Reading preferences (Team ${prefs.teamNumber})`);
      } else {
        btn.setAttribute('aria-label', 'Reading preferences');
        btn.setAttribute('title', 'Reading preferences');
      }
    });
  }

  function boot() {
    reflectToggleTeam(loadPrefs());
  }

  document.addEventListener('mantik:prefs', (e) => reflectToggleTeam((e as CustomEvent<Prefs>).detail));
  boot();
  document.addEventListener('astro:page-load', boot);
</script>
