---
/**
 * Reader preferences drawer: theme, text size, line spacing, contrast, motion.
 * Slides in from the right edge, mirroring the navigation sidebar on the left.
 * State lives in src/lib/prefs.ts; PreferencesButton.astro (in the header)
 * toggles it. Rendered once by BaseLayout, as a sibling of .page.
 */
const groups = [
  {
    key: 'theme',
    label: 'Theme',
    options: [
      { value: 'system', label: 'System' },
      { value: 'light', label: 'Light' },
      { value: 'dark', label: 'Dark' },
    ],
  },
  {
    key: 'text',
    label: 'Text size',
    options: [
      { value: 'sm', label: 'Small' },
      { value: 'md', label: 'Medium' },
      { value: 'lg', label: 'Large' },
      { value: 'xl', label: 'X-Large' },
    ],
  },
  {
    key: 'spacing',
    label: 'Line spacing',
    options: [
      { value: 'normal', label: 'Normal' },
      { value: 'relaxed', label: 'Relaxed' },
    ],
  },
  {
    key: 'contrast',
    label: 'Contrast',
    options: [
      { value: 'normal', label: 'Normal' },
      { value: 'high', label: 'High' },
    ],
  },
  {
    key: 'motion',
    label: 'Motion',
    options: [
      { value: 'system', label: 'System' },
      { value: 'reduce', label: 'Reduce' },
    ],
  },
] as const;
---

<div class="prefs-overlay" data-prefs-overlay hidden></div>
<aside
  class="prefs-drawer"
  id="prefs-drawer"
  role="dialog"
  aria-modal="false"
  aria-label="Reading preferences"
  aria-hidden="true"
  data-prefs-drawer
>
  <div class="prefs-drawer-head">
    <span class="prefs-drawer-title">Reading preferences</span>
    <button class="prefs-close" type="button" data-prefs-close aria-label="Close preferences">×</button>
  </div>

  <div class="prefs-drawer-body">
    {groups.map((g) => (
      <fieldset class="prefs-group" data-prefs-group={g.key}>
        <legend class="prefs-legend">{g.label}</legend>
        <div class="prefs-options" role="radiogroup" aria-label={g.label}>
          {g.options.map((o) => (
            <label class="prefs-option">
              <input type="radio" name={`prefs-${g.key}`} value={o.value} />
              <span>{o.label}</span>
            </label>
          ))}
        </div>
      </fieldset>
    ))}

    <fieldset class="prefs-group prefs-team" data-prefs-team>
      <legend class="prefs-legend">Team colors</legend>
      <p class="prefs-team-hint">
        Enter your FRC team number. Colors come from <a href="https://frc-colors.com/" target="_blank" rel="noopener noreferrer">FRC Colors</a> and are not modified. The site switches to light or dark mode automatically so those colors stay readable.
      </p>
      <div class="prefs-team-row">
        <label class="prefs-team-label">
          <span class="visually-hidden">FRC team number</span>
          <input
            type="number"
            class="prefs-team-input"
            inputmode="numeric"
            min="1"
            max="99999"
            step="1"
            placeholder="e.g. 254"
            data-prefs-team-input
            aria-describedby="prefs-team-status"
          />
        </label>
        <button class="prefs-team-apply" type="button" data-prefs-team-apply>Apply</button>
      </div>
      <div class="prefs-team-swatch" data-prefs-team-swatch hidden>
        <span class="prefs-swatch" data-prefs-swatch-primary aria-hidden="true"></span>
        <span class="prefs-swatch" data-prefs-swatch-secondary aria-hidden="true"></span>
        <span class="prefs-team-swatch-label" data-prefs-team-label></span>
      </div>
      <p class="prefs-team-status" id="prefs-team-status" data-prefs-team-status role="status"></p>
      <button class="prefs-team-clear" type="button" data-prefs-team-clear hidden>Use default colors</button>
    </fieldset>

    <p class="prefs-note">Saved in this browser. Applies to every page on this site.</p>
    <button class="prefs-reset" type="button" data-prefs-reset>Reset to defaults</button>
  </div>
</aside>

<script>
  import {
    loadPrefs,
    updatePrefs,
    savePrefs,
    applyPrefs,
    DEFAULT_PREFS,
    setTeamColorsPrefs,
    clearTeamColorsPrefs,
    hasActiveTeamColors,
    type Prefs,
  } from '@/lib/prefs';
  import { fetchTeamColors, isValidTeamNumber } from '@/lib/teamColors';

  function reflectTeam(drawer: Element) {
    const prefs = loadPrefs();
    const input = drawer.querySelector<HTMLInputElement>('[data-prefs-team-input]');
    const swatch = drawer.querySelector<HTMLElement>('[data-prefs-team-swatch]');
    const label = drawer.querySelector<HTMLElement>('[data-prefs-team-label]');
    const clearBtn = drawer.querySelector<HTMLButtonElement>('[data-prefs-team-clear]');
    const status = drawer.querySelector<HTMLElement>('[data-prefs-team-status]');
    const primary = drawer.querySelector<HTMLElement>('[data-prefs-swatch-primary]');
    const secondary = drawer.querySelector<HTMLElement>('[data-prefs-swatch-secondary]');

    if (input) input.value = prefs.teamNumber != null ? String(prefs.teamNumber) : '';
    const active = prefs.teamColors != null && prefs.teamNumber != null;
    if (swatch) swatch.hidden = !active;
    if (clearBtn) clearBtn.hidden = !active;
    if (status && !status.dataset.pending) status.textContent = '';
    if (active && prefs.teamColors && primary && secondary && label) {
      primary.style.background = prefs.teamColors.primaryHex;
      secondary.style.background = prefs.teamColors.secondaryHex;
      const modeLabel = prefs.teamSiteTheme === 'dark' ? 'Dark' : 'Light';
      label.textContent = `Team ${prefs.teamNumber} · ${modeLabel} mode`;
    }
  }

  function reflect(drawer: Element) {
    const prefs = loadPrefs();
    const teamActive = hasActiveTeamColors(prefs);
    drawer.querySelectorAll<HTMLInputElement>('input[type=radio]').forEach((input) => {
      const key = input.name.replace('prefs-', '') as keyof Prefs;
      if (key in prefs && typeof prefs[key] === 'string') {
        input.checked = prefs[key] === input.value;
      }
      if (key === 'theme') {
        input.disabled = teamActive;
        input.closest('.prefs-option')?.classList.toggle('prefs-option--disabled', teamActive);
      }
    });
    const themeGroup = drawer.querySelector('[data-prefs-group="theme"]');
    themeGroup?.querySelector('.prefs-theme-team-note')?.remove();
    if (teamActive && themeGroup) {
      const note = document.createElement('p');
      note.className = 'prefs-theme-team-note';
      note.textContent = 'Theme is set from your team colors. Clear team colors to change it.';
      themeGroup.appendChild(note);
    }
    reflectTeam(drawer);
  }

  function init() {
    const drawer = document.querySelector<HTMLElement>('[data-prefs-drawer]');
    const overlay = document.querySelector<HTMLElement>('[data-prefs-overlay]');
    if (!drawer || !overlay || drawer.dataset.initialized) return;
    drawer.dataset.initialized = 'true';

    const toggles = () => document.querySelectorAll<HTMLButtonElement>('[data-prefs-toggle]');
    const isOpen = () => drawer.classList.contains('open');

    const open = () => {
      reflect(drawer);
      drawer.classList.add('open');
      drawer.setAttribute('aria-hidden', 'false');
      overlay.hidden = false;
      toggles().forEach((b) => b.setAttribute('aria-expanded', 'true'));
      drawer.querySelector<HTMLInputElement>('input:checked')?.focus({ preventScroll: true });
    };
    const close = (refocus = true) => {
      drawer.classList.remove('open');
      drawer.setAttribute('aria-hidden', 'true');
      overlay.hidden = true;
      toggles().forEach((b) => b.setAttribute('aria-expanded', 'false'));
      if (refocus) toggles()[0]?.focus();
    };

    document.addEventListener('click', (e) => {
      const t = (e.target as Element).closest('[data-prefs-toggle]');
      if (t) (isOpen() ? close() : open());
    });
    drawer.querySelector('[data-prefs-close]')?.addEventListener('click', () => close());
    overlay.addEventListener('click', () => close(false));

    drawer.addEventListener('change', (e) => {
      const input = e.target as HTMLInputElement;
      if (input.type !== 'radio') return;
      const key = input.name.replace('prefs-', '') as keyof Prefs;
      updatePrefs({ [key]: input.value } as Partial<Prefs>);
    });

    drawer.querySelector('[data-prefs-reset]')?.addEventListener('click', () => {
      savePrefs({ ...DEFAULT_PREFS });
      applyPrefs({ ...DEFAULT_PREFS });
      reflect(drawer);
    });

    const teamStatus = drawer.querySelector<HTMLElement>('[data-prefs-team-status]');
    const teamApply = drawer.querySelector<HTMLButtonElement>('[data-prefs-team-apply]');
    const setTeamStatus = (msg: string, pending = false) => {
      if (!teamStatus) return;
      if (pending) teamStatus.dataset.pending = 'true';
      else delete teamStatus.dataset.pending;
      teamStatus.textContent = msg;
    };

    teamApply?.addEventListener('click', async () => {
      const input = drawer.querySelector<HTMLInputElement>('[data-prefs-team-input]');
      const raw = input?.value.trim() ?? '';
      const n = Number(raw);
      if (!isValidTeamNumber(n)) {
        setTeamStatus('Enter a team number from 1 to 99999.');
        return;
      }
      teamApply.disabled = true;
      setTeamStatus('Loading team colors…', true);
      try {
        const colors = await fetchTeamColors(n);
        setTeamColorsPrefs(n, colors);
        setTeamStatus('');
        reflect(drawer);
      } catch (e) {
        setTeamStatus(e instanceof Error ? e.message : 'Could not load team colors.');
      } finally {
        teamApply.disabled = false;
      }
    });

    drawer.querySelector('[data-prefs-team-clear]')?.addEventListener('click', () => {
      clearTeamColorsPrefs();
      reflect(drawer);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) close();
    });
    // Another control (the header theme toggle) changed a preference while open.
    document.addEventListener('mantik:prefs', () => isOpen() && reflect(drawer));
  }

  function boot() {
    applyPrefs(loadPrefs());
    init();
  }
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => applyPrefs(loadPrefs()));
  boot();
  document.addEventListener('astro:page-load', boot);
</script>
