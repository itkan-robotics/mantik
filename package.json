{
  "name": "mantik",
  "type": "module",
  "version": "3.0.0",
  "license": "BSD-3-Clause",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/fetch-java-playground-assets.mjs && node scripts/build-java-launcher.mjs",
    "prestart": "node scripts/fetch-java-playground-assets.mjs && node scripts/build-java-launcher.mjs",
    "prebuild": "node scripts/fetch-java-playground-assets.mjs && node scripts/build-java-launcher.mjs && node scripts/generate-pwa-icons.mjs",
    "dev": "astro dev",
    "dev:netlify": "netlify dev",
    "dev:search": "npm run build && astro dev",
    "start": "astro dev",
    "build": "astro build",
    "build:analyze": "node scripts/build-analyze.mjs",
    "postbuild": "pagefind --site dist && node scripts/generate-offline-module-manifests.mjs && node scripts/build-offline-track-zips.mjs && node scripts/generate-pwa-sw.mjs && node scripts/pwa-audit.mjs",
    "pwa:audit": "node scripts/pwa-audit.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:physics": "vitest run src/lib/pid-sim",
    "test:java-examples": "vite-node scripts/test-java-lesson-examples.ts",
    "migrate": "node scripts/migrate-json-to-mdx.mjs",
    "seed:resources": "node scripts/seed-resources-from-mdx.mjs",
    "fetch:frc-2026-repos": "node scripts/fetch-frc-2026-public-repos.mjs",
    "fetch:frc-2026-repos:quick": "node scripts/fetch-frc-2026-public-repos.mjs --skip-team-scan",
    "fetch:frc-2026-repos:statbotics": "node scripts/fetch-frc-2026-public-repos.mjs --statbotics-only",
    "fetch:frc-2026-repos:curate": "node scripts/fetch-frc-2026-public-repos.mjs --curate-only",
    "fetch:frc-2026-repos:manual": "node scripts/fetch-frc-2026-public-repos.mjs --manual-patch",
    "fetch:dive-teams": "node scripts/fetch-dive-robot-files.mjs",
    "test:dive": "vitest run src/lib/dive"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.0",
    "@astrojs/react": "^6.0.0",
    "@astrojs/sitemap": "^3.4.1",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@lezer/highlight": "^1.2.3",
    "@monaco-editor/react": "^4.7.0",
    "astro": "^7.0.0",
    "monaco-editor": "^0.55.1",
    "pagefind": "^1.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "uplot": "^1.6.32",
    "zod": "^3.25.67"
  },
  "overrides": {
    "dompurify": "^3.4.11",
    "@vite-pwa/astro": {
      "astro": "$astro"
    },
    "monaco-editor": {
      "dompurify": "^3.4.11"
    }
  },
  "devDependencies": {
    "@netlify/functions": "^5.3.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vite-pwa/astro": "^1.2.0",
    "archiver": "^8.0.0",
    "netlify-cli": "^23.0.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.35.5",
    "typescript": "^5.8.3",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.9",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
